# Telegram Kids — конфигурация
# Скопируй этот файл в .env и заполни значения

# Telegram API ключи (с my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Токен бота родителя (от @BotFather)
BOT_TOKEN=your_bot_token_here

# Секретный ключ для API (придумай сам, любая строка)
API_SECRET=change_this_to_random_string

# Публичный URL сервера (для email-ссылок)
SERVER_URL=https://telegram-kids.ru

# SMTP для отправки писем подтверждения
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@telegram-kids.ru
SMTP_PASS=your_smtp_password
SMTP_FROM=Telegram Kids <noreply@telegram-kids.ru>
